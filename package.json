{
	"name": "eslint-plugin-flawless",
	"version": "1.17.0",
	"description": "A personal, opinionated set of ESLint rules",
	"keywords": [
		"eslint",
		"eslint-plugin",
		"typescript-eslint"
	],
	"homepage": "https://github.com/christopher-buss/eslint-plugin-flawless#readme",
	"bugs": "https://github.com/christopher-buss/eslint-plugin-flawless/issues",
	"repository": {
		"url": "git+https://github.com/christopher-buss/eslint-plugin-flawless.git",
		"type": "git"
	},
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./oxlint": "./dist/oxlint.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"prebench": "nr build",
		"bench": "eslint-rule-benchmark run --eslint-config benchmark/eslint.config.mjs",
		"prebench:scaling": "nr build",
		"bench:scaling": "tsx benchmark/scaling.ts",
		"build": "tsdown --clean --dts",
		"check:dts": "tsx scripts/check-dts.ts",
		"create-rule": "tsx scripts/create-rule.ts",
		"dev": "tsdown --stub",
		"eslint-docs": "eslint-doc-generator",
		"posteslint-docs": "eslint --cache --fix \"**/*.md\"",
		"lint": "isentinel-lint",
		"lint:ci": "isentinel-lint",
		"prepare": "simple-git-hooks",
		"prepublishOnly": "nr build",
		"release": "bumpp",
		"start": "tsx src/index.ts",
		"test": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
	},
	"lint-staged": {
		"*": "isentinel-lint --fix"
	},
	"dependencies": {
		"@eslint-react/core": "catalog:runtime",
		"@oxlint/plugins": "catalog:runtime",
		"@typescript-eslint/scope-manager": "catalog:runtime",
		"@typescript-eslint/utils": "catalog:runtime",
		"jsonc-eslint-parser": "catalog:runtime",
		"natural-compare": "catalog:runtime",
		"synckit": "catalog:runtime",
		"toml-eslint-parser": "catalog:runtime"
	},
	"devDependencies": {
		"@antfu/ni": "catalog:cli",
		"@eslint/markdown": "catalog:testing",
		"@isentinel/eslint-config": "catalog:cli",
		"@isentinel/tsconfig": "catalog:types",
		"@types/natural-compare": "catalog:types",
		"@types/node": "catalog:types",
		"@typescript-eslint/eslint-plugin": "catalog:cli",
		"@typescript-eslint/parser": "catalog:cli",
		"@vitest/eslint-plugin": "catalog:testing",
		"bumpp": "catalog:cli",
		"eslint": "catalog:cli",
		"eslint-doc-generator": "catalog:utils",
		"eslint-plugin-eslint-plugin": "catalog:testing",
		"eslint-plugin-n": "catalog:testing",
		"eslint-plugin-pnpm": "catalog:cli",
		"eslint-plugin-toml": "catalog:testing",
		"eslint-plugin-yml": "catalog:testing",
		"eslint-rule-benchmark": "catalog:utils",
		"eslint-vitest-rule-tester": "catalog:testing",
		"jiti": "catalog:cli",
		"lint-staged": "catalog:cli",
		"oxc-parser": "catalog:cli",
		"oxfmt": "catalog:cli",
		"oxlint": "catalog:testing",
		"oxlint-tsgolint": "catalog:cli",
		"publint": "catalog:testing",
		"simple-git-hooks": "catalog:cli",
		"ts-api-utils": "catalog:cli",
		"tsdown": "catalog:cli",
		"tsx": "catalog:cli",
		"typescript": "catalog:cli",
		"unplugin-unused": "catalog:testing",
		"vitest": "catalog:testing",
		"yaml-eslint-parser": "catalog:testing"
	},
	"peerDependencies": {
		"eslint": ">=9.15.0",
		"oxc-parser": "*",
		"oxfmt": "*",
		"oxlint": ">=1.78.0",
		"typescript": ">=4.8.4 <6.1.0"
	},
	"peerDependenciesMeta": {
		"oxc-parser": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
